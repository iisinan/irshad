# ==============================================================================
# IRSHAD - MASTER RAILWAY ENVIRONMENT VARIABLES
# Copy these into your Railway Service Environment Variables
# ==============================================================================

# Application Base Config
APP_NAME=Irshad
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.iirshad.com

# Core Framework Keys
# (Generate a unique key or copy your current APP_KEY from Render)
APP_KEY=base64:3mSty5jT30K2vG2b8s2D8v9X1L2M3N4P5Q6R7S8T9U0=

# Neon PostgreSQL Connection (Frankfurt Region - eu-central-1)
DB_CONNECTION=pgsql
DB_URL="postgres://user:password@endpoint.neon.tech/dbname?sslmode=require"

# Server Engine (Laravel Octane + Roadrunner)
OCTANE_SERVER=roadrunner
PHP_CLI_SERVER_WORKERS=4

# Redis (Point to Railway Redis Service)
REDIS_CLIENT=phpredis
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Google Gemini AI Integration
GEMINI_API_KEY=AIzaSy...

# Resend Transactional Email Config
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_...
MAIL_FROM_ADDRESS="noreply@iirshad.com"
MAIL_FROM_NAME="Irshad"

# Error Tracking & Logging (Sentry)
SENTRY_LARAVEL_DSN=https://...

# AWS S3 Storage (Disclosures & Financial PDFs)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=...

# Frontend VITE Config (For Cloudflare Pages / Railway Web)
VITE_APP_NAME="Irshad"
VITE_API_URL="https://api.iirshad.com/api/v1"
VITE_GOOGLE_CLIENT_ID="695007449342-h6pllbs2fctnjlnq5tr0j9ktlmoaohed.apps.googleusercontent.com"
VITE_POSTHOG_KEY=...
VITE_POSTHOG_HOST="https://app.posthog.com"
VITE_GA_TRACKING_ID=...
