{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigFile": "nixpacks.toml",
    "buildCommand": "composer install --no-dev --optimize-autoloader --ignore-platform-reqs"
  },
  "deploy": {
    "startCommand": "php artisan octane:start --server=roadrunner --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/api/v1/stocks/DANGCEM",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
